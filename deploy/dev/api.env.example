# Copy to /opt/capstone/backend-dev/api.env on the API VM, chmod 600.
# Compose reads this file with format: raw. Values are literal: do not quote them.
# Do not copy appsettings.Local.json into the Docker image.
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_HTTP_PORTS=8080
AllowedHosts=supermarket-api-dev.kitsuracloud.com;localhost;127.0.0.1
ConnectionStrings__SqlServer=Server=capstone-sqlserver,1433;Database=FA26SE103_Dev;User Id=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=True
Jwt__Key=
Jwt__Issuer=FA26SE103
Jwt__Audience=FA26SE103.Client
Jwt__LifetimeMinutes=60
Cors__Origins__0=http://localhost:5173
Cors__Origins__1=http://127.0.0.1:5173
ReverseProxy__Enabled=true
ReverseProxy__KnownProxies__0=192.168.1.243
Swagger__Enabled=true
DataProtection__KeyPath=/app/.local/keys
Video__RecordedRoot=/app/.local/videos
Video__AllowDemo=false
Video__FfmpegPath=ffmpeg
FloorPlan__Provider=Cloudinary
FloorPlan__Root=/app/.local/floor-plans
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__Folder=fa26se103/floor-plans
Cloudinary__TimeoutSeconds=30
# Initially false until Windows FILE paths have been replaced with uploaded videos.
# Set true and recreate API after Test & enable succeeds to resume MF-01 health checks.
CameraHealth__Enabled=false
CameraHealth__IntervalSeconds=30
# The Python AI service is outside this deployment, so keep the continuous runtime stopped.
Monitoring__Enabled=false
Bootstrap__Enabled=false
# Python AI is not deployed; AI preview requests return service-unavailable.
AiPreview__BaseUrl=http://127.0.0.1:8090
